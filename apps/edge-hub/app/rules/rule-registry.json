[
  {
    "id": "dispense_on_stable_gap",
    "priority": 100,
    "condition": "machine.phase == 'rest_dispense_edge' and machine.plate_stable == True and machine.dispense_fired_for_gap == False and system.phase == 'READY'",
    "actions": [{
      "type": "command",
      "params": {
        "name": "dispense.open",
        "payload": { "open_ms": 120 }
      }
    }]
  },

  {
    "id": "stop_on_high_pressure",
    "priority": 150,
    "condition": "machine.pressure > 1.5",
    "actions": [{
      "type": "command",
      "params": { "name": "program.stop" }
    }]
  },

  {
    "id": "auto_reprime_pressure",
    "priority": 120,
    "cooldown_ms": 10000,
    "condition": "machine.pressure < 0.5 and machine.phase == 'rest_dispense_edge'",
    "actions": [{
      "type": "command",
      "params": {
        "name": "pressure.reprime",
        "payload": { "duration_ms": 3000 }
      }
    }]
  },

  {
    "id": "auto_refill",
    "priority": 150,
    "cooldown_ms": 15000,
    "condition": "material.current_pot_kg < 2 and machine.phase == 'rest_dispense_edge'",
    "actions": [{
      "type": "command",
      "params": {
        "name": "refill.start",
        "payload": { "duration_ms": 3000 }
      }
    }]
  },

  {
    "id": "stop_on_paint_empty",
    "priority": 200,
    "condition": "material.paint_confidence == 'LOW'",
    "actions": [{
      "type": "command",
      "params": { "name": "program.stop" }
    }]
  },

  {
    "id": "paint_low_warning",
    "priority": 50,
    "condition": "material.current_pot_kg < machine.pot_min_kg",
    "actions": [{
      "type": "emit_alert",
      "params": {
        "level": "warning",
        "message": "Paint level low – refill soon"
      }
    }]
  }
]
