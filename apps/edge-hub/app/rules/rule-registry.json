[

{
  "id": "dispense_on_gap",
  "enabled": false,
  "priority": 190,
  "cooldown_ms": 200,
  "condition": "program.phase in ['ready', 'running'] and machine.stable == True and material.line_primed == True and material.current_pot_kg > 0.3 and machine.gap == 1",
  "actions": [
    {
      "type": "command",
      "params": {
        "name": "dispense.open",
        "payload": { "open_ms": 400 }
      }
    }
  ]
},

  {
    "id": "stop_on_overpressure",
    "enabled": true,
    "priority": 250,
    "cooldown_ms": 0,
    "condition": "machine.pressure > 2.5",
    "actions": [
      {
        "type": "command",
        "params": {"name": "system.emergency_stop"}
      },
      {
        "type": "emit_alert",
        "params": {
          "level": "critical",
          "message": "Overpressure detected — emergency stop"
        }
      }
    ],
    "meta": {"note": "Safety ceiling regardless of phase. 2.5 bar = well below fire extinguisher rating but safety margin from 3 bar supply"}
  }
]