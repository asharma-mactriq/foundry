[
  {
    "id": "stop_on_paint_empty",
    "enabled": true,
    "priority": 200,
    "cooldown_ms": 15000,
    "condition": "material.paint_confidence == 'LOW' and program.phase in ['running']",
    "actions": [
      {
        "type": "command",
        "params": {"name": "program.stop"}
      },
      {
        "type": "emit_alert",
        "params": {
          "level": "critical",
          "message": "Pot empty during running — program stopped"
        }
      }
    ],
    "meta": {"note": "Only fires in RUNNING, not during startup fill phases"}
  },

  {
    "id": "paint_low_warning",
    "enabled": true,
    "priority": 50,
    "cooldown_ms": 30000,
    "condition": "material.current_pot_kg < material.pot_min_kg and material.pot_min_kg > 0 and program.phase in ['running', 'ready']",
    "actions": [
      {
        "type": "emit_alert",
        "params": {
          "level": "warning",
          "message": "Paint level low — mid-run refill will trigger soon"
        }
      }
    ],
    "meta": {"note": "Warning only — program_engine handles actual refill"}
  },

  {
    "id": "stop_on_overpressure",
    "enabled": true,
    "priority": 250,
    "cooldown_ms": 0,
    "condition": "machine.pressure > 2.5",
    "actions": [
      {
        "type": "command",
        "params": {"name": "system.emergency_stop"}
      },
      {
        "type": "emit_alert",
        "params": {
          "level": "critical",
          "message": "Overpressure detected — emergency stop"
        }
      }
    ],
    "meta": {"note": "Safety ceiling regardless of phase. 2.5 bar = well below fire extinguisher rating but safety margin from 3 bar supply"}
  },

  {
    "id": "alert_reservoir_suspected_low",
    "enabled": true,
    "priority": 150,
    "cooldown_ms": 60000,
    "condition": "material.consecutive_failed_refills >= 1 and program.phase in ['running', 'mid_refilling']",
    "actions": [
      {
        "type": "emit_alert",
        "params": {
          "level": "warning",
          "message": "Refill yielded low gain — reservoir may be running low"
        }
      }
    ],
    "meta": {"note": "Based on outcome, not reservoir weight reading"}
  },

  {
    "id": "stop_on_reservoir_confirmed_empty",
    "enabled": true,
    "priority": 220,
    "cooldown_ms": 0,
    "condition": "material.consecutive_failed_refills >= 2 and program.phase in ['running']",
    "actions": [
      {
        "type": "command",
        "params": {"name": "program.stop"}
      },
      {
        "type": "emit_alert",
        "params": {
          "level": "critical",
          "message": "Reservoir confirmed empty — 2 consecutive refills failed. Program stopped."
        }
      }
    ],
    "meta": {"note": "consecutive_failed_refills is tracked in program_engine, exposed via material_state"}
  }
]