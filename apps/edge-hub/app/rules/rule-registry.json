[
{
  "id": "periodic_dispense_2s",
  "enabled": true,
  "priority": 190,
  "cooldown_ms": 2000,
  "condition": "program.phase == 'running' ",
  "actions": [
    {
      "type": "command",
      "params": {
        "name": "dispense.open",
        "payload": { "open_ms": 400 }
      }
    }
  ],
  "meta": {
    "note": "Dispense pulse every 2s while running and gap visible"
  }
},

  {
    "id": "stop_on_overpressure",
    "enabled": true,
    "priority": 250,
    "cooldown_ms": 0,
    "condition": "machine.pressure > 2.5",
    "actions": [
      {
        "type": "command",
        "params": {"name": "system.emergency_stop"}
      },
      {
        "type": "emit_alert",
        "params": {
          "level": "critical",
          "message": "Overpressure detected — emergency stop"
        }
      }
    ],
    "meta": {"note": "Safety ceiling regardless of phase. 2.5 bar = well below fire extinguisher rating but safety margin from 3 bar supply"}
  },

  {
    "id": "alert_reservoir_suspected_low",
    "enabled": true,
    "priority": 150,
    "cooldown_ms": 60000,
    "condition": "material.consecutive_failed_refills >= 1 and program.phase in ['running', 'mid_refilling']",
    "actions": [
      {
        "type": "emit_alert",
        "params": {
          "level": "warning",
          "message": "Refill yielded low gain — reservoir may be running low"
        }
      }
    ],
    "meta": {"note": "Based on outcome, not reservoir weight reading"}
  },

  {
    "id": "stop_on_reservoir_confirmed_empty",
    "enabled": true,
    "priority": 220,
    "cooldown_ms": 0,
    "condition": "material.consecutive_failed_refills >= 2 and program.phase in ['running']",
    "actions": [
      {
        "type": "command",
        "params": {"name": "program.stop"}
      },
      {
        "type": "emit_alert",
        "params": {
          "level": "critical",
          "message": "Reservoir confirmed empty — 2 consecutive refills failed. Program stopped."
        }
      }
    ],
    "meta": {"note": "consecutive_failed_refills is tracked in program_engine, exposed via material_state"}
  }
]